# ── 8004scan (AltLayer) ─────────────────────────────────────────────
# Optional: lifts the ERC-8004 stats API from anonymous to hackathon Pro tier.
# Create a key at https://8004scan.io/developers then submit the Pro-Tier form.
SCAN8004_API_KEY=

# ── Agent worker (BSC testnet) ──────────────────────────────────────
# TESTNET-ONLY private key for the agent's own wallet. Never a real-funds key.
# Create a fresh wallet, export its key, fund it at:
#   https://www.bnbchain.org/en/testnet-faucet
AGENT_PRIVATE_KEY=

# Minutes between agent heartbeats (default 10)
AGENT_INTERVAL_MIN=10
